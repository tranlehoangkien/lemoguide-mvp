# Copy to backend/.env and adjust for your machine.
# These map to the ${...} placeholders in src/main/resources/application.yaml.
# Load them via your IDE run configuration (IntelliJ: "EnvFile" plugin) or export
# them in your shell before running `./mvnw spring-boot:run`.

# --- MySQL connection ---
DB_URL=jdbc:mysql://localhost:3306/lemoguide_mvp?createDatabaseIfNotExist=true&serverTimezone=UTC&useUnicode=true&characterEncoding=UTF-8
DB_USERNAME=root
DB_PASSWORD=root

# --- Connection pool (HikariCP) ---
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2

# --- JWT (HS256 signing key, must be >= 32 bytes) ---
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-bytes
JWT_EXPIRATION_MS=86400000

# --- Server ---
SERVER_PORT=8080

# --- AI provider API keys ---
# Do NOT add OpenAI/Anthropic/Google/Groq/... keys here. They are managed
# entirely at runtime through the admin "Model AI & API Key" page
# (ai_model table) - adding a provider/model there takes effect immediately,
# no .env edit or restart needed. Env vars are only for secrets that are
# fixed per-deployment, like DB/JWT above.
